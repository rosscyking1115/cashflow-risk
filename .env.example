# Copy to .env and fill in as needed. Every value below has a safe default for
# local development, so the app runs with none of these set. .env is gitignored;
# .env.example (this file, placeholders only) is committed.

# --- Database ---
# Defaults to a local SQLite file. Set to a Postgres URL for a managed database.
# DATABASE_URL=postgresql://user:password@localhost:5432/cashflow

# --- Auth ---
# Signing secret for locally-minted dev tokens. REQUIRED in production; the app
# refuses to boot in production while the insecure default is in use.
# CASHFLOW_JWT_SECRET=change-me-to-a-long-random-string
# Set to "dev" to expose the local /api/auth/dev-token endpoint (never in prod).
CASHFLOW_ENV=dev
# Clerk (production sign-in). Set both to verify Clerk-issued tokens on the API.
# CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://your-app.clerk.accounts.dev

# --- Integrations (optional) ---
# Companies House Public Data API key — enables customer risk enrichment.
# COMPANIES_HOUSE_API_KEY=your-companies-house-api-key
# Sentry DSN — enables PII-scrubbed error reporting.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- Behaviour ---
# Auto-purge window for stored results, in days (default 730 = 24 months).
# CASHFLOW_RETENTION_DAYS=730

# --- Web dashboard (web/) ---
# Points the Next.js app at a non-default API base URL.
# NEXT_PUBLIC_API_BASE=http://localhost:8000
